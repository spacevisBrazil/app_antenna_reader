<?xml version="1.0" encoding="utf-8"?>
<!-- Campo: card branco com borda sv_field_border, raio de campo. Seta no layer. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_card" />
            <stroke android:width="1dp" android:color="@color/sv_field_border" />
            <corners android:radius="@dimen/sv_radius_field" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="14dp"
        android:width="20dp" android:height="20dp" android:drawable="@drawable/ic_chevron_down" />
</layer-list>
