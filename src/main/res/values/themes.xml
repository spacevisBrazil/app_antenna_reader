<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema claro fixo (a plataforma não tem modo escuro; DayNight deixava
         diálogos pretos em aparelho com tema escuro). -->
    <style name="Theme.UHFLogger" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/sv_primary</item>
        <item name="colorPrimaryVariant">@color/sv_sidebar</item>
        <item name="colorOnPrimary">@color/sv_primary_foreground</item>
        <item name="colorSecondary">@color/sv_primary</item>
        <item name="colorOnSecondary">@color/sv_primary_foreground</item>
        <item name="colorAccent">@color/sv_primary</item>
        <item name="colorError">@color/sv_error</item>
        <item name="colorSurface">@color/sv_card</item>
        <item name="colorOnSurface">@color/sv_foreground</item>
        <item name="android:colorBackground">@color/sv_background</item>
        <item name="android:textColorPrimary">@color/sv_foreground</item>
        <item name="android:textColorSecondary">@color/sv_muted_foreground</item>
        <item name="android:windowBackground">@color/sv_background</item>
        <item name="android:statusBarColor">@color/sv_sidebar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/sv_background</item>
        <!-- Inter em toda TextView/Button, inclusive as criadas em Kotlin. -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="materialButtonStyle">@style/Widget.UHFLogger.Button</item>
        <item name="materialCardViewStyle">@style/Widget.UHFLogger.Card</item>
        <item name="alertDialogTheme">@style/UHFLogger.Dialog</item>
        <item name="android:alertDialogTheme">@style/UHFLogger.Dialog</item>
    </style>

    <!-- AlertDialogs (Brand.DIALOG_THEME): mesmas cores e fonte das telas. -->
    <style name="UHFLogger.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/sv_primary</item>
        <item name="colorAccent">@color/sv_primary</item>
        <item name="colorSecondary">@color/sv_primary</item>
        <item name="colorSurface">@color/sv_card</item>
        <item name="colorOnSurface">@color/sv_foreground</item>
        <item name="android:textColorPrimary">@color/sv_foreground</item>
        <item name="android:textColorSecondary">@color/sv_muted_foreground</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="buttonBarPositiveButtonStyle">@style/UHFLogger.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/UHFLogger.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/UHFLogger.DialogButton</item>
    </style>

    <style name="UHFLogger.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/sv_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Widget.UHFLogger.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/sv_radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.UHFLogger.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/sv_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/sv_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/sv_card</item>
    </style>
</resources>
