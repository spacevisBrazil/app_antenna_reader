<?xml version="1.0" encoding="utf-8"?>
<!-- Identidade SpaceVis: cores de res/values/colors.xml (tokens do
     app.spacevis.com.br), Inter vinda do tema, cards raio 16, botões raio 10. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sv_background">

    <!-- Barra do topo: verde da sidebar + logo oficial (proporção original). -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/sv_topbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/sv_sidebar"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="160dp"
            android:layout_height="21dp"
            android:src="@drawable/spacevis_logo"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="SpaceVis" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botão configurações -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Configurações"
            android:background="@drawable/bg_icon_button"
            app:tint="@color/topbar_icon_tint"
            android:padding="12dp" />
    </LinearLayout>

    <!-- Rola só se não couber (coletor 360x640 com o aviso da smartbox
         ligado); com espaço sobrando, fillViewport mantém o rodapé no fundo. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="UHF Logger"
            android:textColor="@color/sv_foreground"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvSubtitle" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leitor RFID UHF"
            android:textColor="@color/sv_muted_foreground"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divisor -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/sv_border"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Cards Status + Tags (estilo vem de materialCardViewStyle do tema) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardTags">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="top">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textColor="@color/sv_muted_foreground"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <!-- Cor do texto trocada junto com o fundo em setCapturingState(). -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parado"
                    android:textColor="@color/sv_foreground"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_badge_gray" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTags"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toEndOf="@id/cardStatus"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="top">

                <TextView
                    android:id="@+id/tvTagCountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAGS CAPTURADAS"
                    android:textColor="@color/sv_muted_foreground"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvTagCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/sv_foreground"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Label dispositivo -->
        <TextView
            android:id="@+id/labelDevice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DISPOSITIVO USB/BLUETOOTH"
            android:textColor="@color/sv_muted_foreground"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Spinner — campo branco com borda input -->
        <Spinner
            android:id="@+id/spinnerDevices"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_spinner_white"
            android:paddingStart="14dp"
            android:paddingEnd="40dp"
            android:popupBackground="@color/sv_card"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/labelDevice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botão START — cores por estado em res/color/btn_primary_* -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="▶  Iniciar leitura"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/btn_primary_text"
            app:backgroundTint="@color/btn_primary_bg"
            android:layout_marginTop="24dp"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/spinnerDevices"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botão STOP — vermelho só quando está lendo; parado fica contornado -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="■  Parar e salvar"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/btn_danger_text"
            app:backgroundTint="@color/btn_danger_bg"
            app:strokeColor="@color/btn_danger_stroke"
            app:strokeWidth="1dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/btnStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Smartbox: linha discreta de status (só com a coleta habilitada;
             sem chave/fazenda fica GONE e a tela é a mesma de antes). -->
        <TextView
            android:id="@+id/tvSmartboxStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/sv_muted_foreground"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnStop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Smartbox: aviso persistente (24 h sem conseguir baixar) — warning. -->
        <TextView
            android:id="@+id/tvSmartboxWarning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/sv_warning_foreground"
            android:textSize="13sp"
            android:padding="12dp"
            android:background="@drawable/bg_warning"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvSmartboxStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Info inferior — ancorado no fundo -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="SpaceVis · RFID UHF Reader"
            android:textColor="@color/sv_muted_foreground"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintTop_toBottomOf="@id/tvSmartboxWarning"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- LED oculto — mantido para compatibilidade com o código -->
        <ImageView
            android:id="@+id/ledStatus"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:src="@drawable/led_gray"
            android:contentDescription="Status LED"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
