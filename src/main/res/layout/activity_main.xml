<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:padding="24dp">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="UHF DATA LOGGER"
        android:textColor="#00E5FF"
        android:textSize="22sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#00E5FF"
        android:alpha="0.3"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LED de status + label -->
    <LinearLayout
        android:id="@+id/layoutStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ledStatus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/led_gray"
            android:contentDescription="Status LED" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PARADO"
            android:textColor="#888888"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Contador de tags -->
    <TextView
        android:id="@+id/tvTagCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tags capturadas: 0"
        android:textColor="#888888"
        android:textSize="13sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="@id/layoutStatus"
        app:layout_constraintBottom_toBottomOf="@id/layoutStatus"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spinner de dispositivos USB -->
    <TextView
        android:id="@+id/labelDevice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="DISPOSITIVO USB"
        android:textColor="#00E5FF"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spinnerDevices"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_spinner"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/labelDevice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão START -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="▶  START CAPTURE"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:textColor="#0D0D0D"
        android:backgroundTint="#00E5FF"
        android:layout_marginTop="32dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/spinnerDevices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão STOP -->
    <Button
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:text="■  STOP &amp; SAVE"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:textColor="#0D0D0D"
        android:backgroundTint="#FF3D3D"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/btnStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Info inferior -->
    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Protocolo UHF V2.1.1 · 115200 baud · CSV → Downloads"
        android:textColor="#444444"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
